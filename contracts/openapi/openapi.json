{
  "openapi": "3.1.0",
  "info": {
    "title": "ToolHelper local service contract",
    "version": "0.1.0"
  },
  "servers": [{ "url": "http://127.0.0.1" }],
  "paths": {
    "/actuator/health": {
      "get": {
        "summary": "Java service health",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "$ref": "#/components/responses/HealthResponse" } }
      }
    },
    "/health": {
      "get": {
        "summary": "C# local service health",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "$ref": "#/components/responses/HealthResponse" } }
      }
    },
    "/api/jobs/{jobId}/events": {
      "get": {
        "summary": "Replayable job event stream",
        "parameters": [
          { "name": "jobId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "Last-Event-ID", "in": "header", "required": false, "schema": { "type": "string" } }
        ],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "SSE stream", "content": { "text/event-stream": {} } } }
      }
    },
    "/api/database/sessions": {
      "post": {
        "summary": "Open an isolated user SQLite session",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateSessionRequest" } } } },
        "responses": { "200": { "description": "Session opened", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } } }
      }
    },
    "/api/database/sessions/{sessionId}/metadata": {
      "get": {
        "summary": "List SQLite objects",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Metadata", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } } }
      }
    },
    "/api/database/sessions/{sessionId}/queries": {
      "post": {
        "summary": "Submit paged SQLite SQL",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Task accepted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } } }
      }
    },
    "/api/database/queries/{taskId}/events": {
      "get": {
        "summary": "Replayable database query events",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "taskId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "Last-Event-ID", "in": "header", "required": false, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "SSE stream", "content": { "text/event-stream": {} } } }
      }
    },
    "/api/java/crypto/aes/encrypt": {
      "post": {
        "summary": "Encrypt data with TOOLHELPER_V3 AES",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AesRequest" } } } },
        "responses": { "200": { "description": "AES encrypted response" }, "400": { "description": "AES request invalid" } }
      }
    },
    "/api/java/crypto/aes/decrypt": {
      "post": {
        "summary": "Decrypt data with TOOLHELPER_V3 AES",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AesRequest" } } } },
        "responses": { "200": { "description": "AES decrypted response" }, "400": { "description": "AES request invalid" } }
      }
    },
    "/api/java/kylin/sessions": {
      "post": { "summary": "Open SSH and SFTP KylinOS session", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/KylinSessionRequest" } } } }, "responses": { "200": { "description": "Session opened" } } }
    },
    "/api/java/kylin/sessions/{sessionId}": {
      "get": { "summary": "Get KylinOS session", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Session state" } } },
      "delete": { "summary": "Close KylinOS session", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Session closed" } } }
    },
    "/api/java/kylin/sessions/{sessionId}/confirmations": {
      "post": { "summary": "Issue short-lived change confirmation", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "operation", "in": "query", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Confirmation token" } } }
    },
    "/api/java/kylin/sessions/{sessionId}/jobs": {
      "post": { "summary": "Submit whitelisted KylinOS operation", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/KylinJobRequest" } } } }, "responses": { "200": { "description": "Job accepted" } } }
    },
    "/api/java/jobs/{jobId}": {
      "get": { "summary": "Get KylinOS job", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "jobId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Job state" } } }
    },
    "/api/java/jobs/{jobId}/events": {
      "get": { "summary": "KylinOS job event stream", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "jobId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "SSE stream", "content": { "text/event-stream": {} } } } }
    },
    "/api/java/jobs/{jobId}/cancel": {
      "post": { "summary": "Cancel KylinOS job", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "jobId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Cancel requested" } } }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "ToolHelper service token" }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "required": ["success", "code", "message", "traceId"],
        "properties": {
          "success": { "type": "boolean" },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "data": {},
          "traceId": { "type": "string" }
        }
      },
      "HealthData": {
        "type": "object",
        "required": ["service", "version", "status", "traceId"],
        "properties": {
          "service": { "type": "string" },
          "version": { "type": "string" },
          "status": { "type": "string", "enum": ["UP"] },
          "traceId": { "type": "string" }
        }
      },
      "CreateSessionRequest": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string" },
          "password": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 65535 } }
        }
      },
      "SseEvent": {
        "type": "object",
        "required": ["eventId", "type", "jobId", "timestamp", "traceId", "payload"],
        "properties": {
          "eventId": { "type": "string" },
          "type": { "type": "string" },
          "jobId": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "traceId": { "type": "string" },
          "payload": { "type": "object" }
        }
      },
      "PingExpandRequest": {
        "type": "object",
        "required": ["input"],
        "properties": { "input": { "type": "string" } }
      },
      "PingStartRequest": {
        "type": "object",
        "required": ["input"],
        "properties": {
          "input": { "type": "string" },
          "concurrency": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
          "count": { "type": "integer", "minimum": 1, "maximum": 10, "default": 4 },
          "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 10000, "default": 1000 }
        }
      },
      "AesRequest": {
        "type": "object",
        "required": ["compatibilityProfile", "mode", "padding", "keySizeBits", "charset", "keyFormat", "ivFormat", "inputFormat", "outputFormat", "key", "iv", "input"],
        "properties": {
          "compatibilityProfile": { "type": "string", "enum": ["TOOLHELPER_V3"] },
          "mode": { "type": "string", "enum": ["CBC", "ECB", "OFB", "CFB", "CTS", "CTR", "GCM"] },
          "padding": { "type": "string", "enum": ["PKCS7", "NONE", "ZEROS", "ANSIX923", "ISO10126"] },
          "keySizeBits": { "type": "integer", "enum": [128, 192, 256] },
          "charset": { "type": "string", "enum": ["UTF-8", "UTF-16LE", "UTF-32LE", "ASCII", "GBK", "ISO-8859-1"] },
          "keyFormat": { "type": "string", "enum": ["TEXT", "HEX", "BASE64"] },
          "ivFormat": { "type": "string", "enum": ["TEXT", "HEX", "BASE64"] },
          "inputFormat": { "type": "string", "enum": ["TEXT", "HEX", "BASE64"] },
          "outputFormat": { "type": "string", "enum": ["TEXT", "HEX", "BASE64"] },
          "key": { "type": "string" },
          "iv": { "type": "string" },
          "input": { "type": "string" }
        }
      },
      "KylinSessionRequest": {
        "type": "object", "required": ["host", "username"],
        "properties": { "host": { "type": "string" }, "port": { "type": "integer", "default": 22 }, "username": { "type": "string" }, "password": { "type": "string", "writeOnly": true }, "privateKey": { "type": "string", "writeOnly": true }, "privateKeyPassphrase": { "type": "string", "writeOnly": true }, "sudoPassword": { "type": "string", "writeOnly": true } }
      },
      "KylinJobRequest": {
        "type": "object", "required": ["operation"],
        "properties": { "operation": { "type": "string" }, "confirmationToken": { "type": "string", "writeOnly": true }, "confirm": { "type": "boolean" } }
      }
    },
    "/api/local/ping/targets/expand": {
      "post": {
        "summary": "Expand group Ping targets",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PingExpandRequest" } } } },
        "responses": { "200": { "description": "Expanded targets", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } } }
      }
    },
    "/api/local/ping/jobs": {
      "post": {
        "summary": "Start group Ping job",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PingStartRequest" } } } },
        "responses": { "200": { "description": "Job started", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } } } }
      }
    },
    "/api/local/ping/jobs/{jobId}": {
      "get": { "summary": "Get group Ping job", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "jobId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Job state" } } }
    },
    "/api/local/ping/jobs/{jobId}/events": {
      "get": { "summary": "Group Ping SSE events", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "jobId", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "Last-Event-ID", "in": "header", "required": false, "schema": { "type": "string" } }], "responses": { "200": { "description": "SSE stream", "content": { "text/event-stream": {} } } } }
    },
    "/api/local/ping/jobs/{jobId}/cancel": {
      "post": { "summary": "Cancel group Ping job", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "jobId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Cancel requested" } } }
    },
    "/api/local/ping/jobs/{jobId}/export": {
      "get": { "summary": "Export group Ping results", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "jobId", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "format", "in": "query", "schema": { "type": "string", "enum": ["csv", "xlsx"] } }], "responses": { "200": { "description": "Export file" } } }
    },
    "responses": {
      "HealthResponse": {
        "description": "Health response",
        "headers": { "X-Trace-Id": { "schema": { "type": "string" } } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResponse" } } }
      }
    }
  }
}
